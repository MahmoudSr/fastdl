{
  "manifest_version": 3,
  "name": "fastdl",
  "version": "0.1.0",
  "description": "Send your downloads to the fastdl app for faster multi-connection downloading.",
  "key": "",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage"
  ],
  "optional_permissions": [
    "cookies"
  ],
  "host_permissions": [
    "http://127.0.0.1:17385/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "fastdl",
    "default_icon": {
      "32": "icons/32.png",
      "64": "icons/64.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  }
}
